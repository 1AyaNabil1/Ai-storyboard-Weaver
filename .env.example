# Copy this file to .env and fill in what you need. .env is ignored by git.

# Which model writes the storyboard: gemini or openai
STORYBOARD_LLM_PROVIDER=gemini
# Optional: override the provider's default text model
# STORYBOARD_LLM_MODEL=

# Scene frames: none (default, no image calls), gemini or openai
STORYBOARD_IMAGE_PROVIDER=none
# Optional: override the provider's default image model
# STORYBOARD_IMAGE_MODEL=
# WIDTHxHEIGHT. OpenAI models accept specific sizes only; Gemini maps it to the closest aspect ratio.
# STORYBOARD_IMAGE_SIZE=1536x1024

# Keys: only the ones for the providers you picked are needed
GEMINI_API_KEY=
OPENAI_API_KEY=

# Any server that speaks the OpenAI REST API works here (OpenAI, OpenRouter,
# Ollama, vLLM, LM Studio, ...). Local servers accept any placeholder key.
# OPENAI_BASE_URL=https://api.openai.com/v1
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Where runs are written and where past storyboards are remembered
# STORYBOARD_OUTPUT_DIR=outputs
# STORYBOARD_KB_PATH=outputs/knowledge_base.json

# How many times to ask the model again when its JSON does not validate
# STORYBOARD_MAX_ATTEMPTS=3
# Per-request timeout in seconds
# STORYBOARD_TIMEOUT=90
